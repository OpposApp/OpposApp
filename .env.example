# Oppos — oppos.app
# Copy to .env.local and fill real values. Never commit secrets.

# Privy (https://dashboard.privy.io)
VITE_PRIVY_APP_ID=YOUR_PRIVY_APP_ID

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Browser RPC — public or your own proxy. Do NOT put paid API keys in VITE_* vars.
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Snapshot / mint indexer (Node only — never prefix secrets with VITE_)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
COLLECTION_MINT=YOUR_METAPLEX_COLLECTION_MINT
# Optional: npm run index-mints:watch polls every 20s (INDEXER_POLL_MS=20000)

# Candy Machine deploy (never commit the secret, never prefix with VITE_)
MINT_AUTHORITY_SECRET=YOUR_BASE58_SECRET_KEY
SOLANA_RPC_URL=https://api.devnet.solana.com
TOKEN_MINT=YOUR_OPPOS_TOKEN_MINT
TREASURY_WALLET=YOUR_TREASURY_PUBKEY
DEV_WALLET=YOUR_DEV_PUBKEY
OPS_WALLET=YOUR_OPS_PUBKEY
# Optional: secondary-market royalty only (220 = 2.2%). Mint is still 0.2 SOL + burn, no extra tax.
# ROYALTY_BPS=220
PASS_METADATA_URI=https://oppos.app/metadata/pass.json
COLLECTION_METADATA_URI=https://oppos.app/metadata/collection.json

# After pump.fun launch — update in Supabase project_config:
# token_mint, treasury_wallet, dev_wallet, ops_wallet, collection_mint, candy_machine, candy_guard
